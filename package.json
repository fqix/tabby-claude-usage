{
  "name": "tabby-claude-usage",
  "version": "0.1.0",
  "description": "Show Claude Code and Codex subscription usage limits in a Tabby status bar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fqix/tabby-claude-usage.git"
  },
  "homepage": "https://github.com/fqix/tabby-claude-usage#readme",
  "bugs": {
    "url": "https://github.com/fqix/tabby-claude-usage/issues"
  },
  "keywords": [
    "tabby-plugin",
    "claude",
    "claude-code",
    "codex",
    "usage",
    "statusbar"
  ],
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "install-local": "npm run build && node scripts/install-local.js",
    "prepublishOnly": "npm test"
  },
  "author": "fengqi",
  "license": "MIT",
  "peerDependencies": {
    "@angular/core": "^15"
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@types/node": "^20.0.0",
    "rxjs": "^7.8.0",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "typescript": "~5.4.0",
    "zone.js": "~0.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
